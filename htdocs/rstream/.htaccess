# rstream.at – Apache-Konfiguration für den Ordner rstream/.
# Dieser Ordner ist der Webroot der Domain rstream.at (im Hosting-Panel auf rstream/ gelegt) und
# gleichzeitig als www.reichi.com/rstream/ erreichbar. Alle Regeln hier funktionieren in beiden
# Fällen; die Regeln aus der übergeordneten .htaccess (Caching, Kompression, Dotfiles)
# gelten zusätzlich, sofern der Hoster sie dort auswertet.

<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

# Fehlerseite: „ErrorDocument“ bräuchte je nach Aufrufart einen anderen Pfad (/404.php bzw.
# /rstream/404.php). Ein relativer Rewrite in diesem Ordner trifft beide Fälle.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.php [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
