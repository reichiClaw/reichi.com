# Optional: Apache-spezifische Verbesserungen. Die Website funktioniert auch ohne diese Datei.

# Verzeichnislisten unterbinden
Options -Indexes

# Standarddokument und Fehlerseite
DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

# Zeichensatz für Textdateien
AddDefaultCharset UTF-8

# Konsistente Weiterleitung auf die kanonische Domain (https://www.reichi.com).
# Erst aktivieren, wenn HTTPS eingerichtet ist; Alias-Domains siehe README.md.
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} off [OR]
#  RewriteCond %{HTTP_HOST} !^www\.reichi\.com$ [NC]
#  RewriteRule ^ https://www.reichi.com%{REQUEST_URI} [R=301,L]
#</IfModule>

# Alte WordPress-Pfade: Medien-URLs der alten Installation auf die Startseite leiten.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^wp-(content|includes|admin|json)(/|$) / [R=301,L]
  RewriteRule ^(feed|comments/feed|xmlrpc\.php)(/|$) / [R=301,L]
</IfModule>

# Caching für statische Dateien (Bilder, CSS, JS erhalten Cache-Busting per ?v=)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # HSTS nur aktivieren, wenn HTTPS dauerhaft funktioniert:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(jpg|jpeg|webp|png|svg|ico|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Kompression für Text
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Dotfiles nicht ausliefern
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
